{
  "name": "ecotrack-hack2skill",
  "version": "1.0.0",
  "description": "Privacy-first carbon footprint awareness platform. Built for Hack2skill Main Challenge 3, June 2026.",
  "main": "index.html",
  "scripts": {
    "test": "jest --coverage",
    "test:ci": "jest --coverage --ci --forceExit",
    "test:watch": "jest --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anandkrshnn-ai/ecotrack-hack2skill.git"
  },
  "keywords": [
    "carbon-footprint",
    "sustainability",
    "ecotrack",
    "climate",
    "india",
    "hack2skill"
  ],
  "author": "Anandakrishnan Damodaran",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/anandkrshnn-ai/ecotrack-hack2skill/issues"
  },
  "homepage": "https://anandkrshnn-ai.github.io/ecotrack-hack2skill/",
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "tailwindcss": "^3.4.19"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 0,
        "functions": 0,
        "branches": 0,
        "statements": 0
      }
    }
  }
}
